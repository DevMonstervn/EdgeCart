# EdgeCart Frontend Environment Configuration
# Copy this file to .env (or .env.production) when configuring build endpoints.

# Local Development (leave empty or set to /api/v1 to use Vite Dev Proxy to http://localhost:8787)
VITE_API_BASE_URL=/api/v1

# Staging Environment:
# VITE_API_BASE_URL=https://api-staging.edgecart.com/api/v1

# Production Environment:
# VITE_API_BASE_URL=https://api.edgecart.com/api/v1
