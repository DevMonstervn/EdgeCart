{
  "name": "@edgecart/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy:staging": "wrangler pages deploy dist --project-name edgecart-frontend --branch staging",
    "deploy:prod": "wrangler pages deploy dist --project-name edgecart-frontend --branch main",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@edgecart/shared": "workspace:*",
    "axios": "^1.7.9",
    "lucide-vue-next": "^0.477.0",
    "pinia": "^3.0.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@edgecart/tsconfig": "workspace:*",
    "@types/node": "^22.13.10",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "happy-dom": "^17.1.8",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vitest": "^3.0.7",
    "vue-tsc": "^2.2.8"
  }
}
